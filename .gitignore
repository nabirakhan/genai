# data, weights, caches (never commit); root-anchored so src/data/ stays tracked
/data/
/outputs/
/checkpoints/
/downloads/
*.pkl
*.pt
*.pth
*.npy
*.npz
kaggle.json
.env
.env.*
!.env.example

# APTOS may not be redistributed and the repo is public: outputs that show real APTOS images
# or per-image APTOS labels stay local (the report PDF uses them)
/results/figures/gradcam_*
/results/figures/memorization_*
/results/tables/memorization_f*.csv
/results/tables/rps_scores.csv

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# web
web/node_modules/
web/dist/
web/.vercel/

# docs sources kept local
*.docx

# stylegan3 build artefacts inside the submodule
third_party/stylegan3/**/__pycache__/

# Playwright MCP scratch
.playwright-mcp/
