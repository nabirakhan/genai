diff --git a/torch_utils/misc.py b/torch_utils/misc.py
index 335397d..5e7508f 100644
--- a/torch_utils/misc.py
+++ b/torch_utils/misc.py
@@ -161,6 +161,36 @@ def copy_params_and_buffers(src_module, dst_module, require_all=False):
         if name in src_tensors:
             tensor.copy_(src_tensors[name].detach()).requires_grad_(tensor.requires_grad)
 
+@torch.no_grad()
+def copy_params_and_buffers_tolerant(src_module, dst_module, verbose=False):
+    """copy_params_and_buffers(require_all=False) that survives shape mismatches.
+
+    Exact-shape tensors are copied. 2-D weights with the same leading dim and a wider
+    destination get the overlapping column slice copied (mapping.fc0.weight when a class
+    embedding is appended to z). Everything else keeps its fresh initialisation.
+    Needed to fine-tune a conditional (--cond=1) network from an unconditional pickle.
+    """
+    assert isinstance(src_module, torch.nn.Module)
+    assert isinstance(dst_module, torch.nn.Module)
+    src_tensors = dict(named_params_and_buffers(src_module))
+    copied, partial, skipped, new = [], [], [], []
+    for name, tensor in named_params_and_buffers(dst_module):
+        if name not in src_tensors:
+            new.append(name)
+            continue
+        src = src_tensors[name].detach()
+        if src.shape == tensor.shape:
+            tensor.copy_(src)
+            copied.append(name)
+        elif src.ndim == 2 and tensor.ndim == 2 and src.shape[0] == tensor.shape[0] and src.shape[1] < tensor.shape[1]:
+            tensor[:, :src.shape[1]].copy_(src)
+            partial.append(f'{name} {list(src.shape)}->{list(tensor.shape)}')
+        else:
+            skipped.append(f'{name} {list(src.shape)}!={list(tensor.shape)}')
+    if verbose:
+        print(f'  copied {len(copied)} tensors; partial: {partial}; skipped: {skipped}; new: {new}')
+    return dict(copied=copied, partial=partial, skipped=skipped, new=new)
+
