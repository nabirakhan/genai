         for name, module in [('G', G), ('D', D), ('G_ema', G_ema)]:
-            misc.copy_params_and_buffers(resume_data[name], module, require_all=False)
+            misc.copy_params_and_buffers_tolerant(resume_data[name], module, verbose=True)
 
     # Print network summary tables.
     if rank == 0:
@@ -179,6 +179,18 @@ def training_loop(
         if ada_target is not None:
             ada_stats = training_stats.Collector(regex='Loss/signs/real')
 
+    # Restore the ADA augmentation probability when resuming from one of our own snapshots
+    # (upstream only copies G/D/G_ema, so p would restart at 0 after every session break).
+    # Done on every rank because augment_pipe has no parameters and is not DDP-broadcast.
+    if (resume_pkl is not None) and (augment_pipe is not None):
+        with dnnlib.util.open_url(resume_pkl) as f:
+            _resume_aug = legacy.load_network_pkl(f).get('augment_pipe')
+        if _resume_aug is not None:
+            augment_pipe.p.copy_(_resume_aug.p.to(device))
+            if rank == 0:
+                print(f'Restored ADA p = {float(augment_pipe.p):.3f}')
+        del _resume_aug
+
     # Distribute across GPUs.
     if rank == 0:
         print(f'Distributing across {num_gpus} GPUs...')
